default_platform(:ios)

APP_ID = "com.gulergamestudios.buyukyemin"
PROJECT = "ios/App/App.xcodeproj"

platform :ios do
  desc "Dağıtım sertifikası + App Store profili oluştur, derle, TestFlight'a yükle"
  lane :beta do
    setup_ci # geçici anahtarlık (keychain)

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_KEY_ID"],
      issuer_id: ENV["APP_STORE_ISSUER_ID"],
      key_filepath: ENV["APP_STORE_KEY_PATH"],
      duration: 1200
    )

    cert_id = nil
    begin
      # Bu çalıştırmaya özel dağıtım sertifikası (özel anahtar sadece bu Mac'te kalır)
      get_certificates(api_key: api_key, development: false, generate_apple_certs: true)
      cert_id = lane_context[SharedValues::CERT_CERTIFICATE_ID]

      # Yeni sertifikayı içeren App Store profili
      get_provisioning_profile(api_key: api_key, app_identifier: APP_ID, force: true,
                               cert_id: cert_id, filename: "BuyukYemin_AppStore.mobileprovision")
      profile_name = lane_context[SharedValues::SIGH_NAME]

      update_code_signing_settings(
        path: PROJECT, targets: ["App"], use_automatic_signing: false,
        team_id: ENV["APPLE_TEAM_ID"], code_sign_identity: "Apple Distribution",
        profile_name: profile_name, bundle_identifier: APP_ID
      )

      build_app(
        project: PROJECT, scheme: "App", configuration: "Release",
        output_directory: "build", output_name: "BuyukYemin.ipa",
        export_method: "app-store",
        export_options: { provisioningProfiles: { APP_ID => profile_name } },
        xcargs: "CURRENT_PROJECT_VERSION=#{ENV['BUILD_NUMBER']} DEVELOPMENT_TEAM=#{ENV['APPLE_TEAM_ID']}"
      )

      upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
    ensure
      # Geçici sertifikayı iptal et (App Store / TestFlight yapıları etkilenmez; Apple kendisi yeniden imzalar)
      if cert_id
        begin
          Spaceship::ConnectAPI::Certificate.get(certificate_id: cert_id).delete!
          UI.message("Geçici dağıtım sertifikası iptal edildi: #{cert_id}")
        rescue => e
          UI.important("Sertifika iptal edilemedi (#{cert_id}): #{e.message}")
        end
      end
    end
  end
end
